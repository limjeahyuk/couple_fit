rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function partnerOf(uid) { return get(/databases/$(db)/documents/users/$(uid)).data.get('partnerId', null); }
    // Owner, or a partner where both sides point at each other (request + accept).
    function isPair(uid) {
      return signedIn() && (request.auth.uid == uid
        || (partnerOf(uid) == request.auth.uid && partnerOf(request.auth.uid) == uid));
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      // Readable by any signed-in user so codes / incoming requests can be queried.
      // Holds name, code, partnerId, nudgeAt, avatar — nothing secret.
      allow read: if signedIn();
      allow write: if isOwner(uid);

      match /routines/{id} { allow read, write: if isPair(uid); }
      match /sessions/{id} { allow read: if isPair(uid); allow write: if isOwner(uid); }
      match /body/{date} { allow read: if isPair(uid); allow write: if isOwner(uid); } // shared with partner only
      match /private/{doc} { allow read, write: if isOwner(uid); } // FCM tokens
    }
  }
}
